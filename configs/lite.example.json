{
  "run_dir": "../runs/example",
  "dataset": "../data/example",
  "python": "../.venv/bin/python",
  "target_model": "../models/target.gguf",
  "initial_draft": "../models/draft.gguf",
  "capture_binary": "../build/dflash-capture",
  "tokenize_binary": "../build/dflash-tokenize",
  "server_binary": "../runtime/build/bin/llama-server",
  "gguf_python_dir": "../runtime/gguf-py",
  "gpu_uuids": [
    "0",
    "1"
  ],
  "environment": {},
  "max_epochs": 1,
  "max_shard_rows": 256,
  "shard_feature_budget_gib": 1,
