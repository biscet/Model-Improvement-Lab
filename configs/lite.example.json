  "benchmark_test_rows": 16,
  "max_new_tokens": 320,
  "capture_context": 14336,
  "training_context": 384,
  "training_objective": "uniform",
  "batch_size": 4,
  "learning_rate": 2.5e-06,
  "checkpoint_bytes_estimate": 7500000000,
  "output_name": "draft-candidate-F16.gguf",
  "model_name": "ModelImprovementLab-candidate",
  "production_service": null,
  "production_scope": "user",
  "production_url": "http://127.0.0.1:1234",
  "production_config": null,
  "production_launcher": null,
  "benchmark_url": "http://127.0.0.1:1238",
  "server_argv": [
    "{server_binary}",
    "--model",
    "{target_model}",
    "--host",
    "127.0.0.1",
    "--port",
    "1238",
    "--device",
    "CUDA0,CUDA1",
    "--split-mode",
    "none",
    "--gpu-layers",
    "all",
    "--override-tensor",
    "^per_layer_token_embd[.]weight$=CUDA1,.*=CUDA0",
    "--ctx-size",
    "16384",
    "--parallel",
    "1",
    "--batch-size",
    "512",
    "--ubatch-size",
    "256",
    "--flash-attn",
    "on",
    "--cache-type-k",
    "bf16",
    "--cache-type-v",
    "bf16",
    "--spec-type",
    "draft-dflash",
    "--spec-draft-model",
    "{initial_draft}",
    "--spec-draft-device",
    "CUDA0",
    "--spec-draft-ngl",
    "all",
    "--spec-draft-override-tensor",
    ".*=CUDA0",
    "--spec-draft-type-k",
    "bf16",
    "--spec-draft-type-v",
    "bf16",
    "--spec-draft-n-max",
    "3",
    "--spec-draft-p-min",
    "0",
    "--slots"
  ],
  "mentor": {
    "endpoint": "https://api.deepseek.com/v1/chat/completions",
    "model": "deepseek-flash",
    "key_env": "DEEPSEEK_API_KEY",
    "timeout_seconds": 600,
    "reasoning_effort": "high",
    "language": "en"
